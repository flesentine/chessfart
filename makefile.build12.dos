CC=wcl
CFLAGS=-zq -bt=dos -ml -3 -ox -w4 -Iinclude

DOS_SOURCES=src\main_build11.c src\game\board.c src\game\gas.c src\game\cpu_config.c src\game\cpu_actions.c src\game\cpu_eval.c src\game\cpu_search.c src\game\cpu_format.c src\game\ux.c src\game\font.c src\game\board_view_build5.c src\game\board_view_build6.c src\game\board_view_build7.c src\game\presentation.c src\game\audio.c src\game\audio_samples.c src\game\audio_game.c src\game\persistence.c src\game\persistence_ui.c src\platform\dos\vga_dos.c src\platform\dos\input_build5_dos.c src\platform\dos\audio_dos.c src\platform\dos\mouse_dos.c

.ERASE

all: dos

dos:
	@if not exist build mkdir build
	@if not exist build\dos mkdir build\dos
	$(CC) $(CFLAGS) -fe=build\dos\CHESSFRT.EXE $(DOS_SOURCES)
	@echo Built Chess Fart 1.0.0-rc1: build\dos\CHESSFRT.EXE

clean:
	-if exist build\dos\CHESSFRT.EXE del build\dos\CHESSFRT.EXE
	-if exist *.obj del *.obj
